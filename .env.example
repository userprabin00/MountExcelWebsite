# Mount Excel Boarding School - Environment Configuration
# Copy this file to .env and configure for your environment.
# NEVER commit the real .env file or production credentials to version control.

# Application Environment ('development' or 'production')
APP_ENV=production
APP_NAME="Mount Excel Boarding School"
APP_KEY="change_this_to_a_random_32_character_secret_string"
SITE_URL="https://mountexcel.edu.np"

# Database Configuration (Use a least-privileged user in production)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mount_excel_school
DB_USER=mount_excel_app
DB_PASS=replace_with_a_strong_database_password

# School Contact & Notification Settings
SCHOOL_EMAIL=mountexcel.principal@gmail.com
SCHOOL_PHONE=+977-9851148834

# Setup access (required for admin/setup.php in production)
SETUP_TOKEN=replace_with_a_long_random_setup_token

# Cloudflare Turnstile (leave secret empty to disable; site key is public)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Trust forwarded client IP/HTTPS headers only from these proxy IPs; empty by default
TRUSTED_PROXIES=

# SMTP Email Notification Configuration (PHPMailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=mountexcel.principal@gmail.com
SMTP_PASS=your_app_specific_password_here
SMTP_SECURE=tls
MAIL_FROM_ADDRESS=mountexcel.principal@gmail.com
MAIL_FROM_NAME="Mount Excel Boarding School"

# Session Security (Session lifetime in seconds)
SESSION_LIFETIME=7200

# Secure Storage Paths (Optional: defaults to storage outside web root)
# BACKUP_PATH="C:/xampp/mount_excel_storage/backups"
# LOG_PATH="C:/xampp/mount_excel_storage/logs"

# Apache RewriteBase Configuration (e.g. / or /MountExcelWebsite/)
REWRITE_BASE=/MountExcelWebsite/
