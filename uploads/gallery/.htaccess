# uploads/.htaccess
# Security: allow only image files, deny PHP execution, deny directory listing

Options -Indexes

# Deny direct access to everything by default
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# Allow only jpg/jpeg/png/webp files to be served
<FilesMatch "\.(jpg|jpeg|png|webp)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</FilesMatch>

# Absolutely prevent PHP/script execution in this directory
<FilesMatch "\.(php|php3|php4|php5|php7|php8|phtml|phar|pl|py|cgi|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Disable script engine
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Force content type for images
<IfModule mod_headers.c>
    <FilesMatch "\.(jpg|jpeg)$">
        Header set Content-Type "image/jpeg"
    </FilesMatch>
    <FilesMatch "\.png$">
        Header set Content-Type "image/png"
    </FilesMatch>
    <FilesMatch "\.webp$">
        Header set Content-Type "image/webp"
    </FilesMatch>
</IfModule>
